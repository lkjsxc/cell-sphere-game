{
  "name": "cell-sphere-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cell-sphere-game — a deterministic spherical roguelite ecology. Every extinction becomes memory.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.js tests/unit/simulation/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:file": "node scripts/browser-file-test.mjs",
    "test:browser:canvas": "node scripts/browser-file-test.mjs --canvas",
    "check:structure": "node scripts/check-structure.mjs",
    "check:links": "node scripts/check-links.mjs",
    "balance": "node scripts/balance.mjs",
    "balance:smoke": "node scripts/balance.mjs --smoke",
    "showcase:generate": "node scripts/generate-title-showcase.mjs",
    "showcase:check": "node scripts/generate-title-showcase.mjs --check",
    "terminal:soak": "node scripts/audits/terminal-soak.mjs",
    "audit:cell-visuals": "node scripts/audits/cell-visual-audit.mjs",
    "audit:lakes": "node scripts/audits/lake-audit.mjs",
    "audit:events": "node scripts/audits/event-audit.mjs",
    "audit:habitats": "node scripts/audits/habitat-audit.mjs",
    "audit:skills": "node scripts/audits/skill-audit.mjs",
    "audit:trophies": "node scripts/audits/trophy-audit.mjs",
    "audit:adaptations": "node scripts/audits/adaptation-removal-audit.mjs",
    "audit:campaign": "node scripts/audits/campaign-audit.mjs",
    "audit:score": "node scripts/audits/campaign-audit.mjs",
    "audit:identity": "node scripts/audits/identity-audit.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lkjsxc/cell-sphere-game"
  }
}
