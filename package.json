{
  "name": "cell-sphere-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cell-sphere-game — a deterministic spherical roguelite ecology. Every extinction becomes memory.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.js tests/unit/presentation/*.test.js tests/unit/simulation/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:file":"node scripts/browser-file-test.mjs",
    "test:browser:canvas":"node scripts/browser-file-test.mjs --canvas",
    "test:browser:fallback":"node scripts/browser-file-test.mjs --simulation-fallback",
    "test:browser:life-boundaries":"node scripts/browser-file-test.mjs --life-boundary-only",
    "test:browser:life-boundaries:canvas":"node scripts/browser-file-test.mjs --life-boundary-only --canvas",
    "test:browser:atmosphere":"node scripts/browser-file-test.mjs --atmosphere-only",
    "test:browser:atmosphere:canvas":"node scripts/browser-file-test.mjs --atmosphere-only --canvas",
    "test:browser:environment-pressure":"node scripts/browser-file-test.mjs --environment-pressure-only",
    "test:browser:environment-pressure:fallback":"node scripts/browser-file-test.mjs --environment-pressure-only --simulation-fallback",
    "test:browser:environment-pressure:canvas":"node scripts/browser-file-test.mjs --environment-pressure-only --simulation-fallback --canvas",
    "check:structure": "node scripts/check-structure.mjs",
    "check:links": "node scripts/check-links.mjs",
    "balance": "node scripts/balance.mjs",
    "balance:smoke": "node scripts/balance.mjs --smoke",
    "showcase:generate": "node scripts/generate-title-showcase.mjs",
    "showcase:check": "node scripts/generate-title-showcase.mjs --check",
    "terminal:soak": "node scripts/audits/terminal-soak.mjs",
    "audit:cell-visuals": "node scripts/audits/cell-visual-audit.mjs",
    "audit:resources": "node scripts/audits/resource-audit.mjs",
    "audit:freshwater": "node scripts/audits/freshwater-audit.mjs",
    "audit:score-trace": "node scripts/audits/score-trace-audit.mjs",
    "audit:transformations": "node scripts/audits/transformation-audit.mjs",
    "audit:reach100": "node scripts/audits/reach100-audit.mjs",
    "audit:lakes": "node scripts/audits/lake-audit.mjs",
    "audit:no-disaster": "node scripts/audits/no-disaster-audit.mjs",
    "audit:habitats": "node scripts/audits/habitat-audit.mjs",
    "audit:skills": "node scripts/audits/skill-audit.mjs",
    "audit:trophies": "node scripts/audits/trophy-audit.mjs",
    "audit:adaptations": "node scripts/audits/adaptation-removal-audit.mjs",
    "audit:campaign": "node scripts/audits/campaign-audit.mjs",
    "audit:score": "node scripts/audits/campaign-audit.mjs",
    "audit:identity": "node scripts/audits/identity-audit.mjs",
    "audit:evolution-levels": "node scripts/audits/skill-audit.mjs",
    "audit:environment-levels": "node scripts/audits/environment-level-audit.mjs",
    "audit:luminous": "node scripts/audits/luminous-audit.mjs",
    "audit:progression-numbers": "node scripts/audits/progression-number-audit.mjs",
    "audit:autonomous-feel": "node scripts/autonomous-world-feel-audit.mjs",
    "agent:play": "node scripts/agent-play.mjs",
    "agent:smoke": "node --test tests/unit/agent.test.js tests/integration/agent-environment.test.js && node scripts/agent-tournament.mjs --smoke",
    "agent:campaign": "node scripts/agent-play.mjs campaign --worlds 5",
    "agent:long": "node scripts/agent-play.mjs campaign --worlds 12 --policies balanced,breadth-first,depth-first,sustainability,luminous,marine,conservative,random-legal --report reports/agent-long.json",
    "balance:holdout": "node scripts/agent-tournament.mjs --holdout --worlds 6",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lkjsxc/cell-sphere-game"
  }
}
