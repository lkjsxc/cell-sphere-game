{
  "name": "incremental-network-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "incremental-network-game — a deterministic spherical roguelite incremental game. Every extinction becomes memory.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:file": "node scripts/browser-file-test.mjs",
    "test:browser:canvas": "node scripts/browser-file-test.mjs --canvas",
    "check:structure": "node scripts/check-structure.mjs",
    "check:links": "node scripts/check-links.mjs",
    "balance": "node scripts/balance.mjs",
    "balance:smoke": "node scripts/balance.mjs --smoke",
    "showcase:generate": "node scripts/generate-title-showcase.mjs",
    "showcase:check": "node scripts/generate-title-showcase.mjs --check",
    "terminal:soak": "node scripts/audits/terminal-soak.mjs",
    "audit:rivers": "node scripts/audits/river-audit.mjs",
    "audit:events": "node scripts/audits/event-audit.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lkjsxc/incremental-network-game"
  }
}
